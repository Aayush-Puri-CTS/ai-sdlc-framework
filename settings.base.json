{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "templates/settings.base.json — hydrated into .claude/settings.json by scripts/scaffold.mjs. Every '<<FROM_CONFIG:...>>' array entry below is a sentinel the scaffolder recognizes and replaces with the expanded rule list generated from this repo's project.config.yml permissions.* block. Never hand-edit a hydrated settings.json's deny/ask/allow arrays directly — edit project.config.yml and re-run the scaffolder, or the two will drift (spec section 9, criterion 3: zero command/path duplication). If the target repo already has an unrelated settings.json (no $ai_sdlc_framework_managed signature — added automatically by scaffold.mjs, not present in this template), the scaffolder migrates whatever permission rules it can't derive from project.config.yml into .claude/settings.local.json once, rather than overwriting them; see docs/CONFORMANCE.md.",
  "agent": "coordinator",
  "permissions": {
    "deny": [
      "<<FROM_CONFIG:permissions.deny_read AS Read() RULES>>",
      "<<FROM_CONFIG:permissions.deny_cmd_patterns AS Bash() RULES>>",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/agents/**)",
      "Write(.claude/agents/**)"
    ],
    "ask": [
      "<<FROM_CONFIG:permissions.ask_cmd_patterns AS Bash() RULES>>",
      "<<FROM_CONFIG:permissions.ask_write_paths AS Edit()+Write() RULES>>",
      "Edit(project.config.yml)",
      "Write(project.config.yml)",
      "Edit(project.config.schema.json)",
      "Write(project.config.schema.json)"
    ],
    "allow": [
      "<<FROM_CONFIG:permissions.allow_write_paths AS Edit()+Write() RULES>>",
      "Bash(git add:*)",
      "Bash(git checkout -b:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/validate-config.mjs\" --config \"$CLAUDE_PROJECT_DIR/project.config.yml\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-handoff.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-loop.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-loop.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-loop.sh\""
          }
        ]
      }
    ]
  }
}
